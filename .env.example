PORT=3010

# LLM vendor: "fireworks" (default) or "openai"
LLM_PROVIDER=fireworks
FIREWORKS_API_KEY=your_fireworks_api_key
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Used when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key

DEEPGRAM_API_KEY=your_deepgram_api_key

# Live web search (Tavily). One credit per basic search. Off if key is empty.
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=your_tavily_api_key
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_DEPTH=basic

# Gmail (virtual app + Google OAuth). Client id/secret from Cloud Console.
# Add this exact redirect URI on the OAuth client (Web application):
#   http://localhost:3010/api/gmail/callback
# Works even if the downloaded JSON was a Desktop/installed app — still use this URI.
GMAIL_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3010/api/gmail/callback
# Optional cheap model for the mail agent:
# GMAIL_AGENT_MODEL=gpt-4o-mini
# Fireworks: GMAIL_AGENT_MODEL=accounts/fireworks/models/gpt-oss-20b

# ── Voice-critical (keep latency low here) ────────────────────────────
# OpenAI default (LLM_PROVIDER=openai): gpt-4.1-mini — fast TTFT, good tool calling
# OPENAI_MODEL=gpt-4.1-mini
# Max quality (slower / higher TPM): OPENAI_MODEL=gpt-4.1
# Fastest/cheapest OpenAI: OPENAI_MODEL=gpt-4.1-nano or gpt-4o-mini
# Fireworks default (LLM_PROVIDER=fireworks): Nemotron 3 Ultra
# OPENAI_MODEL=accounts/fireworks/models/nemotron-3-ultra-nvfp4
# Faster Fireworks main (~12x less output $ than Ultra):
# OPENAI_MODEL=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b
MAIN_TEMPERATURE=0.76
# OpenAI: gpt-4o-mini · Fireworks default: gpt-oss-120b
# FOLLOWUP_MODEL=gpt-4o-mini
# FOLLOWUP_MODEL=accounts/fireworks/models/gpt-oss-120b
# In-turn step mode (speak → enrich → continue on same TTS stream):
STEP_MODE_ENABLED=true
STEP_ENRICH_WAIT_MS=700
# Watchdog: abort a stalled tool-loop round (esp. the post-tool "step_continue"
# round) after this many ms with no token/tool-call chunk, and speak a short
# fallback instead of leaving the turn stuck silently.
MAIN_ROUND_IDLE_TIMEOUT_MS=12000

# ── Lean AI budget (background only — never blocks TTS) ───────────────
# Main reply quality stays intact. These cut optional/enrichment spend.
#
# Agents (true = on). Memory AI is highest value for personalization.
MEMORY_AI_ENABLED=true
THOUGHT_AGENT_ENABLED=true
SNAPSHOT_AGENT_ENABLED=true
#
# Expensive multipliers — leave false unless you want richer live coaching:
# BACKGROUND_AI_ON_PARTIALS=true   # thinker/snapshot on every STT partial
# BACKGROUND_AI_FORCE_ON_TOOLS=true # bypass rate limits when main uses tools
BACKGROUND_AI_ON_PARTIALS=false
BACKGROUND_AI_FORCE_ON_TOOLS=false
#
# Idle Bridge — after June finishes speaking, maybe weave in one Thinker whisper
# if the user stays quiet (~1.5–2s). Prefetched in parallel with the silence.
FOLLOWUP_ENABLED=true
FOLLOWUP_DELAY_MS=1700
FOLLOWUP_GRACE_MS=600
FOLLOWUP_RATE_LIMIT_MS=25000
#
# Background models (cheap chat by default).
# OpenAI: gpt-4o-mini · Fireworks default: gpt-oss-20b
# MEMORY_AI_MODEL=gpt-4o-mini
# THOUGHT_AI_MODEL=gpt-4o-mini
# SNAPSHOT_AI_MODEL=gpt-4o-mini
# MEMORY_AI_MODEL=accounts/fireworks/models/gpt-oss-20b
# THOUGHT_AI_MODEL=accounts/fireworks/models/gpt-oss-20b
# SNAPSHOT_AI_MODEL=accounts/fireworks/models/gpt-oss-20b
# Use o4-mini only if you want deeper reasoning on a specific agent (OpenAI).
# MEMORY_AI_MODEL=o4-mini
# THOUGHT_AI_MODEL=o4-mini
# SNAPSHOT_AI_MODEL=o4-mini
THOUGHT_REASONING_EFFORT=low
THOUGHT_DEBOUNCE_MS=1500
THOUGHT_RATE_LIMIT_MS=12000
SNAPSHOT_DEBOUNCE_MS=2000
SNAPSHOT_RATE_LIMIT_MS=10000
SNAPSHOT_MAX_AGE_MS=180000
#
# Dictation / brainstorm — dump speech with no auto-turns, then format.
# Cheap classifier/formatter uses MEMORY_AI_MODEL. Off = normal conversation only.
BRAINSTORM_ENABLED=true

# Skip session-end consolidation LLM for chats shorter than N turns
# (chat is still saved immediately without an extra LLM call):
CONSOLIDATE_MIN_TURNS=3

# Memory System
MEMORY_TOKEN_BUDGET=600

# TTS Provider: "elevenlabs", "cartesia", or "browser"
TTS_PROVIDER=elevenlabs

# Cartesia TTS
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_MODEL=sonic-3

# ElevenLabs TTS
# Flash v2.5 = realtime WebSocket. eleven_v3 = expressive HTTP stream (higher latency).
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=qSeXEcewz7tA0Q0qk9fH
ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_MODEL=eleven_v3

# Deepgram Flux model: flux-general-multi (10 langs, auto-detect) or flux-general-en (English only)
STT_MODEL=flux-general-multi
# Optional seed language hints for multi (comma-separated BCP-47). Empty = auto-detect.
# STT_LANGUAGE_HINTS=en,es
# After N EndOfTurns in the same language, lock that language for higher accuracy.
STT_LANGUAGE_LOCK_AFTER=2
STT_SAMPLE_RATE=16000
TTS_SAMPLE_RATE=24000
EAGER_EOT_THRESHOLD=0.5
EOT_THRESHOLD=0.7
EOT_TIMEOUT_MS=3000
