PORT=3010

DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=your_openai_api_key
# Voice-critical (keep fast):
OPENAI_MODEL=gpt-4.1
MAIN_TEMPERATURE=0.76
FOLLOWUP_MODEL=gpt-4o-mini
# In-turn step mode (speak → enrich → continue on same TTS stream):
STEP_MODE_ENABLED=true
STEP_ENRICH_WAIT_MS=700
# Background only — never blocks TTS:
MEMORY_AI_MODEL=o4-mini
# Thinker coach (tone + whispers + tools). medium effort is fine because it's async.
THOUGHT_AI_MODEL=o4-mini
THOUGHT_REASONING_EFFORT=medium
SNAPSHOT_AI_MODEL=o4-mini
THOUGHT_DEBOUNCE_MS=500
THOUGHT_RATE_LIMIT_MS=6000

# Memory System
MEMORY_TOKEN_BUDGET=600

# TTS Provider: "elevenlabs", "cartesia", or "browser"
TTS_PROVIDER=elevenlabs

# Cartesia TTS
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_MODEL=sonic-3

# ElevenLabs TTS
# Flash v2.5 = realtime WebSocket. eleven_v3 = expressive HTTP stream (higher latency).
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=qSeXEcewz7tA0Q0qk9fH
ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_MODEL=eleven_v3

STT_SAMPLE_RATE=16000
TTS_SAMPLE_RATE=24000
EAGER_EOT_THRESHOLD=0.5
EOT_THRESHOLD=0.7
EOT_TIMEOUT_MS=3000
